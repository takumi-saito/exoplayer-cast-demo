<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.ExoPlayerCastDemo" parent="Theme.AppCompat.Light.NoActionBar">
        <!-- Colors for MediaRouter components -->
        <item name="android:colorBackground">@color/white</item>
        <item name="colorPrimary">@color/purple_500</item>
        <item name="colorPrimaryDark">@color/purple_700</item>
        <item name="colorAccent">@color/teal_200</item>
        <item name="colorControlNormal">@color/black</item>
        <item name="colorControlActivated">@color/purple_500</item>
    </style>

    <!-- Dark theme for ExpandedControlsActivity -->
    <style name="Theme.CastVideosDark" parent="Theme.AppCompat.NoActionBar">
        <item name="android:colorBackground">@color/black</item>
        <item name="colorPrimary">@color/purple_500</item>
        <item name="colorPrimaryDark">@color/purple_700</item>
        <item name="colorAccent">@color/teal_200</item>
        <item name="android:windowBackground">@color/black</item>
    </style>
</resources>